API_PORT=8000
POSTGRES_PORT=5432

POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

APP_DEBUG=true
APP_JURY_API_TOKEN=

APP_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/postgres
APP_DATABASE_POOL_SIZE=5
APP_DATABASE_MAX_OVERFLOW=10
APP_DATABASE_POOL_TIMEOUT_SECONDS=30

APP_SERVER_HOST=0.0.0.0
APP_SERVER_PORT=8000
APP_SERVER_RELOAD=true

APP_LOGGING_LEVEL=DEBUG
APP_LOGGING_SQL_LEVEL=WARNING
APP_LOGGING_FORMAT=text

APP_BOT_TOKEN=replace-with-max-bot-token
APP_BOT_MODE=long_polling

