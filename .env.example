APP_DEBUG=false
APP_SERVER_HOST=0.0.0.0
APP_SERVER_PORT=8000
APP_SERVER_RELOAD=false
APP_LOGGING_LEVEL=INFO
APP_LOGGING_SQL_LEVEL=WARNING
APP_LOGGING_FORMAT=text

# Local launch from backend/. Docker Compose supplies its own PostgreSQL URL.
APP_DATABASE_URL=sqlite+aiosqlite:///./route.db
# Demo accounts and labelled synthetic notification events. Disable for a real pilot.
APP_DEMO_ENABLED=true

# Required only for the MAX login/bot. Never commit real values.
APP_BOT_TOKEN=
APP_BOT_USERNAME=
APP_BOT_MODE=long_polling
# Optional webhook mode (long polling requires no public webhook):
# APP_BOT_WEBHOOK_URL=https://your-host.example/webhook
# APP_BOT_WEBHOOK_SECRET=
# APP_BOT_WEBHOOK_PORT=8080

APP_SESSION_TTL_SECONDS=86400
APP_INIT_DATA_TTL_SECONDS=3600
APP_SCHEDULER_INTERVAL_SECONDS=15

# Docker Compose local access: http://localhost:8080
FRONTEND_PORT=8080
POSTGRES_PASSWORD=route_local
