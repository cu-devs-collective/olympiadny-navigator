# EditorConfig is awesome: https://EditorConfig.org

root = true

[*]
end_of_line = lf
indent_style = space
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[.vscode/**.json]
indent_size = 4

[*.json]
indent_size = 2
insert_final_newline = false

[*.{yml,yaml}]
indent_size = 2

[*.{js,ts}]
indent_size = 2

[*.py]
indent_size = 4

[*.sh]
indent_size = 2

[Makefile]
indent_style = tab
